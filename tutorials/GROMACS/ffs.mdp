integrator               = md
nsteps                   = 0      
dt                       = 0.005   
comm-mode                = Linear
nstcomm                  = 1
nstxout                  = 0
nstvout                  = 0
nstfout                  = 0
nstlog                   = 100
nstenergy                = 100
nstxout-compressed       = 0
cutoff-scheme            = Verlet
ns-type                  = grid
nstlist                  = 1         
rlist                    = 1.0  
coulombtype              = cut-off
rcoulomb                 = 0.0      
vdwtype                  = cut-off
rvdw                     = 2.5
DispCorr                 = No 
tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 0.5  
ref-t                    = 120.3  
pcoupl                   = no
pbc                      = xyz 
constraints              = none

gen-vel                  = yes
gen-temp                 = 120.3
gen-seed                 = 42
