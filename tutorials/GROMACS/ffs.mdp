integrator               = md
nsteps                   = 0
dt                       = 0.005
comm-mode                = Linear
nstcomm                  = 100       

nstxout                  = 0
nstvout                  = 0
nstfout                  = 0


cutoff-scheme            = Verlet
nstlist                  = 10         
rlist                    = 2.5      

coulombtype              = cut-off
rcoulomb                 = 2.5      

vdwtype                  = cut-off
rvdw                     = 2.5     
DispCorr                 = No

tcoupl                   = v-rescale
tc-grps                  = System
tau-t                    = 0.5
ref-t                    = 120.3

pcoupl                   = no

pbc                      = xyz

gen-vel                  = yes
gen-temp                 = 120.3
gen-seed                 = 42

constraints              = none
