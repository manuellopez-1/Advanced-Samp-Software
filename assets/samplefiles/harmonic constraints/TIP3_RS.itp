
;;Restrained rigid TIP3 water using normal constraints
;;(so it can coexist with the main TIP3 SETTLE water)

[ moleculetype ]
; name     nrexcl
TIP3_RS    2

[ atoms ]
; nr   type  resnr  residu  atom  cgnr   charge     mass
   1    OT      1    TIP3   OH2     1   -0.834000  15.9994
   2    HT      1    TIP3    H1     2    0.417000   1.0080
   3    HT      1    TIP3    H2     3    0.417000   1.0080

[ constraints ]
; ai   aj  funct   d
   1    2    1    0.09572
   1    3    1    0.09572
   2    3    1    0.15139

[ exclusions ]
   1   2   3
   2   1   3
   3   1   2

#ifdef POSRES_FB
[ position_restraints ]
; atom  funct  geometry  r_fb    k
   1      2        1     0.0717  125000
#endif
